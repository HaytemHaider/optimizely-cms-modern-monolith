# -----------------------------
coverage/
coverage-*/
.nyc_output/

# Playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/

# -----------------------------
# Optimizely CMS (local dev/generated content)
# -----------------------------
# Local blobs/media (if using filesystem blob provider in dev)
App_Data/Blobs/
App_Data/blobs/

# Temp/cache/logs/packages generated locally
App_Data/TEMP/
App_Data/Temp/
App_Data/cache/
App_Data/Cache/
App_Data/logs/
App_Data/Logs/
App_Data/packages/
App_Data/Packages/

# Optimizely license (usually sensitive)
License.config
license.config

