*.swp
*.swo
*~

# -----------------------------
# Visual Studio local workspace (root + nested, e.g. test/.vs)
# -----------------------------
.vs/
**/.vs/

# Visual Studio solution cache (newer .slnx local sqlite files)
*.slnx.sqlite
*.slnx.sqlite*
*.slnx.sqlite_*

# Temporary backup files created by VS / project edits
*.csproj.Backup.tmp
*.vbproj.Backup.tmp
*.tmp

# -----------------------------
# Optimizely local/protected module payloads (generated/restored zips)
# Ignore if you don't intentionally version these package zips
# -----------------------------
**/modules/_protected/**/*.zip

# Optional: if your team never commits extracted protected modules at all
# **/modules/_protected/**

# -----------------------------
# Misc local IDE state sometimes outside .vs
# -----------------------------
*.vsidx